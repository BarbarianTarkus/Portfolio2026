# Cloudflare Workers Static Assets honours this file (_headers).
# GitHub Pages ignores it, so the same build works on both targets.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-hashed client bundles from _fresh/ never change under the same name.
/_fresh/*
  Cache-Control: public, max-age=31536000, immutable

/styles/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/companies/*
  Cache-Control: public, max-age=86400

/projects/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# Pages are tiny and rebuilt on every deploy, so revalidate them.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

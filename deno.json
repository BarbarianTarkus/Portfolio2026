{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "fmt": "deno fmt .",
    "dev": "deno run -A --watch=main.ts,dev.ts,config,plugins,lib --watch-exclude=_fresh,dist,node_modules,data,.dune dev.ts",
    "build": "deno run -A scripts/build.ts",
    "start": "deno task build && deno serve --port 8001 -A _fresh/server.js",
    "ssg": "deno run -A scripts/ssg.ts",
    "preview": "deno run -A scripts/preview.ts",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "dist/",
    "node_modules/",
    ".scannerwork/",
    "data/",
    ".dune/",
    "islands/dune-admin/"
  ],
  "imports": {
    "@/": "./",
    "@std/http": "jsr:@std/http@^1.1.4",
    "@std/path": "jsr:@std/path@^1.1.6",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "fresh/dev": "jsr:@fresh/core@^2.3.3/dev",
    "preact": "npm:preact@^10.29.8",
    "preact/hooks": "npm:preact@^10.29.8/hooks",
    "preact/jsx-runtime": "npm:preact@^10.29.8/jsx-runtime",
    "preact/jsx-dev-runtime": "npm:preact@^10.29.8/jsx-dev-runtime",
    "preact-render-to-string": "npm:preact-render-to-string@^6.8.2",
    "@preact/signals": "npm:@preact/signals@^2.11.4",
    "@dune/core": "jsr:@dune/core@0.35.0",
    "@dune/core/bootstrap": "jsr:@dune/core@0.35.0/bootstrap",
    "@dune/core/content": "jsr:@dune/core@0.35.0/content",
    "@dune/core/plugins": "jsr:@dune/core@0.35.0/plugins",
    "@dune/plugin-admin": "jsr:@dune/plugin-admin@3.1.3",
    "@dune/plugin-admin/admin/mount": "jsr:@dune/plugin-admin@3.1.3/admin/mount",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/encoding/hex": "jsr:@std/encoding@^1.0.11/hex",
    "marked": "npm:marked@^15.0.12",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "@mdx-js/mdx": "npm:@mdx-js/mdx@^3.1.1",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "sharp": "npm:sharp@^0.33.5",
    "nodemailer": "npm:nodemailer@^6.10.1",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.24.0",
    "@db/sqlite": "jsr:@db/sqlite@^0.12",
    "postgres": "npm:postgres@^3.4.9",
    "ioredis": "npm:ioredis@^5.11.1",
    "polizy": "npm:polizy@^0.6.1",
    "@dune/core/hooks": "jsr:@dune/core@0.35.0/hooks",
    "@dune/plugin-admin/admin/guards": "jsr:@dune/plugin-admin@3.1.3/admin/guards",
    "@dune/plugin-inline-edit": "jsr:@dune/plugin-inline-edit@2.2.3",
    "@dune/core/fresh-app": "jsr:@dune/core@0.35.0/fresh-app",
    "@dune/core/ui/editable": "jsr:@dune/core@0.35.0/ui/editable",
    "@dune/core/security": "jsr:@dune/core@0.35.0/security"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  },
  "fmt": {
    "exclude": [
      "content/"
    ]
  }
}
